# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local Azure Functions settings
local.settings.json
backend/local.settings.json

# Azure Functions build/publish artifacts
# .python_packages/ is produced by a remote build; bin/ and obj/ by Core Tools;
# the zip is what `func azure functionapp publish` packs up.
.python_packages/
backend/.python_packages/
bin/
obj/
*.zip

# Compiled Bicep output.
# `az bicep build-params` RESOLVES readEnvironmentVariable(), writing the real
# SQL admin password and API keys into the generated JSON - never commit it.
# `az bicep build` output is harmless but still just a build artifact.
infra/*.json
infra/**/*.json

# Local Azurite emulator data
azurite/

# Local Functions host run logs
backend/func_start.log
*.log

# graphify knowledge-graph output (regenerate with /graphify)
graphify-out/

SQL_SERVER=localhost
SQL_DATABASE=FoodApp
SQL_UID=
SQL_PWD=
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Azurite's well-known local dev storage connection string - safe to keep as-is for local dev
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1
BLOB_CONTAINER_UPLOADS=uploads
QUEUE_NAME_JOBS=jobs
SAS_TOKEN_EXPIRY_MINUTES=15

MENU_CACHE_TTL_HOURS=24
MENU_MATCH_CONFIDENCE_THRESHOLD=0.6
VECTOR_SEARCH_TOP_K=5

# Per-user quotas capping AI spend (shared/rate_limit.py). Scanning and recipe
# generation are counted separately: scanning happens automatically on every photo,
# while reverse-engineering is user-triggered and is the most expensive call in the
# pipeline. Set RATE_LIMIT_ENABLED=false to turn quotas off entirely for local dev.
RATE_LIMIT_ENABLED=true
SCAN_RATE_LIMIT_PER_HOUR=10
SCAN_RATE_LIMIT_PER_DAY=30
RECIPE_RATE_LIMIT_PER_HOUR=5
RECIPE_RATE_LIMIT_PER_DAY=15

# true raises NotImplementedError until Phase 3 wires real Entra ID JWT validation in
ENTRAID_ENABLED=false
STUB_AUTH_HEADER_NAME=X-Debug-User-Oid
STUB_DEFAULT_USER_OID=

# Real restaurant-search (Google Places Text Search) and menu-fetch (Claude + web search)
GOOGLE_PLACES_API_KEY=
PLACES_TIMEOUT_SECONDS=8
ANTHROPIC_API_KEY=
# Locally this is a first-party Anthropic model id. In Azure it is overwritten with the
# Foundry DEPLOYMENT name (see CLAUDE_BASE_URL below) - Foundry rejects model ids.
MENU_FETCH_MODEL=claude-sonnet-5
MENU_FETCH_TIMEOUT_SECONDS=60
MENU_FETCH_MAX_RETRIES=2

# --- Phase 3 (set by infra/modules/function-app.bicep in Azure) ----------------------
# Leave blank locally: the code paths that read these are still stubs, and local dev keeps
# calling the first-party Anthropic API via ANTHROPIC_API_KEY above.

# Microsoft Foundry. When CLAUDE_BASE_URL is set, the Anthropic SDK's AnthropicFoundry
# client is used and MENU_FETCH_MODEL / VISION_MODEL_DEPLOYMENT must be deployment names.
CLAUDE_BASE_URL=
VISION_MODEL_DEPLOYMENT=

# Azure OpenAI embeddings on the same Foundry account. text-embedding-3-small is 1536-dim,
# matching CulinaryEmbeddings.Embedding VECTOR(1536).
AZURE_OPENAI_ENDPOINT=
EMBEDDING_DEPLOYMENT_NAME=

# Azure AI Content Safety - image moderation before a photo enters the pipeline.
# Leave the endpoint/key blank locally: with no account configured the moderation
# activity reports "unchecked" and lets the photo through, so local dev still works.
# (It would not work anyway - the service fetches the image by URL, and Azurite's
# 127.0.0.1 blob endpoint is not reachable from Azure.)
#
# Image severities are 0/2/4/6. Rejecting at 4 ("medium") rather than 2 ("low")
# avoids failing plausible food photos that read low on a category.
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_REJECT_SEVERITY=4
CONTENT_SAFETY_TIMEOUT_SECONDS=10
CONTENT_SAFETY_MAX_RETRIES=2

# Entra External ID. ENTRAID_ENABLED=true makes shared/auth.py raise NotImplementedError
# until real JWT validation is implemented.
#
# ENTRA_API_CLIENT_ID is the API app registration - the audience the backend validates
# tokens against. It is NOT the SPA client ID; that one is a frontend build-time variable
# (frontend/.env: VITE_ENTRA_CLIENT_ID). Wiring the SPA ID here would fail audience
# validation.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_AUTHORITY_URL=
ENTRA_JWKS_URI=

# Not currently used - kept as a name-only placeholder for a possible Yelp Fusion fallback
YELP_API_KEY=

# --- AWS ---------------------------------------------------------------------------
# AWS_REGION is set for you inside Lambda. Locally it falls back to AWS_DEFAULT_REGION.
AWS_DEFAULT_REGION=eu-west-2

# Point boto3 at LocalStack for local dev. Leave BLANK in a deployed environment -
# anything non-empty overrides normal endpoint resolution and would break the Lambda.
AWS_ENDPOINT_URL=http://localhost:4566

# Dummy credentials are fine against LocalStack; deployed, the Lambda's execution role
# supplies real ones and these must be unset.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DDB_TABLE_NAME=replate
S3_BUCKET_UPLOADS=replate-uploads
SQS_QUEUE_NAME=replate-jobs
# Set from the SAM template when deployed. Blank locally: shared/queue.py then creates
# the queue by name against LocalStack.
SQS_QUEUE_URL=
PRESIGNED_URL_EXPIRY_MINUTES=15

MENU_CACHE_TTL_HOURS=24
MENU_MATCH_CONFIDENCE_THRESHOLD=0.6
VECTOR_SEARCH_TOP_K=5

# Per-user quotas capping AI spend (shared/rate_limit.py). Scanning and recipe
# generation are counted separately: scanning happens automatically on every photo,
# while reverse-engineering is user-triggered and is the most expensive call in the
# pipeline. Set RATE_LIMIT_ENABLED=false to turn quotas off entirely for local dev.
RATE_LIMIT_ENABLED=true
SCAN_RATE_LIMIT_PER_HOUR=10
SCAN_RATE_LIMIT_PER_DAY=30
RECIPE_RATE_LIMIT_PER_HOUR=5
RECIPE_RATE_LIMIT_PER_DAY=15

# true raises NotImplementedError until Phase 3 wires real Cognito JWT handling in.
# Must match the frontend's VITE_COGNITO_ENABLED.
COGNITO_ENABLED=false
STUB_AUTH_HEADER_NAME=X-Debug-User-Oid
STUB_DEFAULT_USER_OID=

# Real restaurant-search (Google Places Text Search) and menu-fetch
GOOGLE_PLACES_API_KEY=
PLACES_TIMEOUT_SECONDS=8
ANTHROPIC_API_KEY=
MENU_FETCH_MODEL=claude-sonnet-5
MENU_FETCH_TIMEOUT_SECONDS=60
MENU_FETCH_MAX_RETRIES=2

# --- Phase 3 (set by the SAM template when deployed) --------------------------------
# Leave blank locally: the code paths that read these are still stubs.

# Amazon Bedrock. No API key - the Lambda's execution role authenticates, so only the
# model ids are configured here. Model access must be granted per-model per-region in
# the Bedrock console first.
BEDROCK_VISION_MODEL_ID=
BEDROCK_MENU_MODEL_ID=
BEDROCK_GENERATOR_MODEL_ID=
# Titan Text Embeddings V2, 1024-dim (was text-embedding-3-small at 1536).
BEDROCK_EMBEDDING_MODEL_ID=

# Image moderation via Amazon Rekognition DetectModerationLabels. No endpoint or key -
# IAM again. Leave the confidence blank to take the default.
#
# Rekognition returns a 0-100 confidence per label rather than Azure's 0/2/4/6 severity,
# so the threshold is a percentage. Set it high enough not to fail plausible food photos.
MODERATION_MIN_CONFIDENCE=
MODERATION_TIMEOUT_SECONDS=10
MODERATION_MAX_RETRIES=2

# Menu page discovery. Bedrock does not expose Anthropic's server-side web_search tool,
# so fetch_restaurant_menu is search -> fetch -> extract and needs a SERP provider.
# This is the only stored API key the AWS design introduces.
SERP_API_KEY=
SERP_API_ENDPOINT=
SERP_TIMEOUT_SECONDS=10

# Amazon Cognito. COGNITO_ENABLED=true makes shared/auth.py raise NotImplementedError
# until real JWT handling is implemented.
#
# COGNITO_APP_CLIENT_ID is the audience the backend validates tokens against. Once API
# Gateway's JWT authorizer is in front of these handlers it does the validation and the
# handler only reads the `sub` claim out of the request context.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=

# Not currently used - kept as a name-only placeholder for a possible Yelp Fusion fallback
YELP_API_KEY=

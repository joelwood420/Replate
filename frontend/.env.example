VITE_API_BASE_URL=http://localhost:7071/api

# false (default) mocks sign-in locally - no real Entra tenant exists yet (matches the
# backend's ENTRAID_ENABLED seam). true mounts a real MSAL provider but is inert until
# Phase 3 provisions a tenant.
VITE_ENTRAID_ENABLED=false
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY_URL=

# Mock-auth request header - must match the backend's STUB_AUTH_HEADER_NAME/
# STUB_DEFAULT_USER_OID so a locally-created job's owner oid matches what job_result_http
# expects.
VITE_STUB_AUTH_HEADER_NAME=X-Debug-User-Oid
VITE_STUB_DEFAULT_USER_OID=00000000-0000-0000-0000-000000000001

# Local dev default. For the deployed site, set this to the stack's ApiBaseUrl output
# (https://<api-id>.execute-api.ap-southeast-2.amazonaws.com). No /api suffix - the
# routes are /jobs, /restaurants/search, etc.
VITE_API_BASE_URL=http://localhost:3000

# false (default) mocks sign-in locally - no Cognito needed. true wires the real
# Cognito user pool via the in-app SDK (amazon-cognito-identity-js) - a custom
# sign-up/sign-in form, not a hosted-UI redirect. Set true for the deployed build;
# the backend is deployed with COGNITO_ENABLED=true, so the two must agree.
VITE_COGNITO_ENABLED=false

# --- Filled in from `sam deploy` stack outputs (Phase 3a) ---------------------------
# VITE_COGNITO_AUTHORITY   <- CognitoIssuer output
#   (https://cognito-idp.ap-southeast-2.amazonaws.com/<userPoolId>)
# VITE_COGNITO_USER_POOL_ID <- UserPoolId output (e.g. ap-southeast-2_xxxxxxxxx) -
#   the in-app SDK needs the raw pool id, not just the issuer URL.
# VITE_COGNITO_CLIENT_ID    <- UserPoolClientId output
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Defaults to window.location.origin, which is already a registered callback URL for
# both the CloudFront site and http://localhost:5173 (set in the SAM template's app
# client). Only override to pin a specific redirect.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_SCOPE=openid profile email

# Mock-auth request header - must match the backend's STUB_AUTH_HEADER_NAME/
# STUB_DEFAULT_USER_OID so a locally-created job's owner oid matches what the job
# read endpoint expects. Unused once VITE_COGNITO_ENABLED=true (a real Bearer token
# is sent instead).
VITE_STUB_AUTH_HEADER_NAME=X-Debug-User-Oid
VITE_STUB_DEFAULT_USER_OID=00000000-0000-0000-0000-000000000001

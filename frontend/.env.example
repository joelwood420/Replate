VITE_API_BASE_URL=http://localhost:3000

# false (default) mocks sign-in locally - no Cognito user pool exists yet (matches the
# backend's COGNITO_ENABLED seam). true mounts a real OIDC provider but is inert until
# Phase 3 provisions a pool.
VITE_COGNITO_ENABLED=false

# Issuer URL: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
# Defaults to window.location.origin. Must be registered as a callback URL on the
# Cognito app client, which is why it is a two-pass step in Phase 3 - the CloudFront
# domain does not exist until the first deploy.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_SCOPE=openid profile email

# Mock-auth request header - must match the backend's STUB_AUTH_HEADER_NAME/
# STUB_DEFAULT_USER_OID so a locally-created job's owner oid matches what the job
# read endpoint expects.
VITE_STUB_AUTH_HEADER_NAME=X-Debug-User-Oid
VITE_STUB_DEFAULT_USER_OID=00000000-0000-0000-0000-000000000001
